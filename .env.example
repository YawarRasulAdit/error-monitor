# Copy to .env and fill in. See README.md for where each value comes from.

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client
GOOGLE_REDIRECT_URI=http://localhost:4600/auth/google/callback

# Error groups to read: the ID at the end of the group URL (chat.google.com/room/<ID>), comma separated.
# The Google account you connect must be a member of each group.
SPACES=

# Optional. Empty = "Ask Claude" uses this machine's logged-in Claude Code CLI (`claude`).
# Set a key from console.anthropic.com when the service runs somewhere without Claude Code.
ANTHROPIC_API_KEY=

# Folders that hold the module repos, comma separated. Claude reads the failing function from here.
REPO_DIRS=C:/Users/yawar.rasul_adit/Documents/adit/backend,C:/Users/yawar.rasul_adit/Documents/adit/front

PORT=4600
# 127.0.0.1 = only this machine. To share with the team use 0.0.0.0 and set DASH_PASSWORD.
HOST=127.0.0.1
# Browser login password (any username) when HOST is not localhost
DASH_PASSWORD=

# "Error Monitor" bot (optional). Leave BOT_KEY_FILE empty to keep the bot off.
# Service account JSON key for the Chat app (README, "Error Monitor bot"). data/ is git-ignored, so keep it there.
BOT_KEY_FILE=
# Groups the bot posts in, comma separated. Each must also be in SPACES. Start with a test group.
BOT_SPACES=
# The Chat app's name as people @mention it
BOT_NAME=Error Monitor
# Chat app events (DMs to the bot, @mentions) read instantly from the app's Pub/Sub subscription.
# Empty = no DM answers, and @mentions wait for the next sync. Format: projects/<project>/subscriptions/<name>
PUBSUB_SUBSCRIPTION=

# 1 = thread replies are answered within about a minute
SYNC_MINUTES=1
# How far back the very first sync reads each group
FIRST_SYNC_DAYS=7
# Alerts older than this are dropped
KEEP_DAYS=30
